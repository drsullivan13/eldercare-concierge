# Public Supabase project values. Never add a service-role or secret key here.
# Leave unset for the explicitly labeled local demo at /dashboard?demo=1.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Off by default, so every dashboard visit opens the local demo.
# Opt in with true plus both values above, then rebuild; see "Enable accounts" in README.md.
NEXT_PUBLIC_ENABLE_ACCOUNTS=false
