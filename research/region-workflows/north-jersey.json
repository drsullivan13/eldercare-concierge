{
  "schema_version": 1,
  "market": {
    "id": "north-jersey",
    "state": "NJ",
    "label": "North Jersey"
  },
  "read_only": false,
  "known_gaps": [
    "Collection, owner-check success and runtime publication are separate states. This workflow never asserts market completion.",
    "Office location, licensed care unit, campus, service ZIP edge, consumer aggregate and clinical evidence retain their existing owners and meanings.",
    "No live availability or pricing is established. Restricted sources remain restricted.",
    "Refresh runs only explicitly configured public collectors. Listing/review discovery and source permissions remain with their existing tools."
  ],
