        {
          "path": "research/north-jersey/state/raw/ccrc.pdf",
          "role": "source",
          "sha256_from": {
            "path": "research/north-jersey/state/coverage.json",
            "pointer": "/sources/ccrc/sha256"
          }
        },
        {
          "path": "research/north-jersey/state/*/care-units.json",
          "role": "output"
        },
        {
          "path": "research/north-jersey/state/*/home-care-firms.json",
          "role": "output"
        },
        {
          "path": "research/north-jersey/state/*/ccrc-campuses.json",
          "role": "output"
        },
        {
          "path": "research/north-jersey/state/unresolved-home-care-counties.json",
          "role": "coverage"
        }
      ],
      "known_gaps": [
        "Checks raw source receipts, county projections and provenance links. Historical campus publication and registration dates require a current check."
      ]
    },
