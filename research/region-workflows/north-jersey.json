        "refresh": {
          "argv": [
            "python3",
            "scripts/regions/nj_collect.py",
            "--download",
            "--collect-firms",
            "--verify-live"
          ],
          "timeout_seconds": 1800
        },
        "rebuild": {
          "argv": [
            "python3",
            "scripts/regions/nj_collect.py"
          ],
          "timeout_seconds": 180
        },
        "verify": {
          "argv": [
            "python3",
            "scripts/regions/workflow-evidence.py",
            "state"
          ]
        }
      },
      "artifacts": [
        {
          "path": "research/north-jersey/state/coverage.json",
          "role": "coverage",
          "metadata": [
            "/counties",
            "/sources",
            "/county_counts",
            "/limitations"
          ]
        },
        {
          "path": "research/north-jersey/state/raw/ltc.xlsx",
          "role": "source",
          "sha256_from": {
            "path": "research/north-jersey/state/coverage.json",
            "pointer": "/sources/ltc/sha256"
          }
        },
        {
          "path": "research/north-jersey/state/raw/firms.xlsx",
          "role": "source",
          "sha256_from": {
            "path": "research/north-jersey/state/coverage.json",
            "pointer": "/sources/firms/sha256"
          }
