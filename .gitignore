# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Browser test output and local reports
/playwright-report/
/test-results/
/artifacts/
!.env.example

# Regional collector work files. The reviewed release and compact source receipts are tracked.
__pycache__/
/research/north-jersey/listing-index/cache/
/research/north-jersey/listing-index/raw/
/research/north-jersey/listing-index/discovery/pages/
/research/north-jersey/listing-index/runs/
/research/north-jersey/listing-index/discovery/normalized-observations.json
/research/north-jersey/listing-index/refresh-state.json
/research/north-jersey/reviews/runs/
/research/north-jersey/clinical/*-test-output.txt
